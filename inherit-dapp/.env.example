# Server
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=legacy
DB_PASSWORD=legacy_password
DB_NAME=legacy_db
DB_SSL_MODE=disable

# Blockchain
CHAIN_RPC_ENDPOINT=http://localhost:26657
CHAIN_GRPC_ENDPOINT=localhost:9090
CHAIN_ID=legacy-testnet-1
KEYRING_BACKEND=test
NODE_HOME=~/.legacyd

# IPFS
IPFS_API_ENDPOINT=http://localhost:5001/api/v0

# Monitor
MONITOR_ENABLED=true
HEARTBEAT_CHECK_INTERVAL=60

# Security
JWT_SECRET=change-me-in-production
